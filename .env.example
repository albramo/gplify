# gplify — انسخ الملف ده لـ `.env` واملأ قيمك الخاصة. الملف ده آمن للرفع على GitHub.
# NEVER commit the real `.env` (it is git-ignored).

# --- Supabase (الواجهة + prerender) ---
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-PUBLISHABLE-KEY"

# --- رابط المتجر العام (يستخدم في الـ prerender للـ canonical/sitemap) ---
SITE_URL="https://your-domain.vercel.app"

# --- سكربت التهيئة فقط (supabase/seed.ts) — server-side، لا تضعها في VITE_ ---
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-SECRET"

# --- Edge functions (تتظبط على Supabase نفسه، مش هنا) ---
# supabase secrets set RESEND_API_KEY=... FROM_EMAIL="gplify <orders@your-domain>" SITE_URL=https://your-domain.vercel.app
